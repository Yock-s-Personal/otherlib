#include "shader-modules/simulation-environment.glsl"
#include "shader-modules/basic-lighting.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba16f) uniform writeonly image3D OE_env_cubemap;
uniform sampler3D OE_voxel_tex;

uniform float OE_ao_strength;

float oe_sky_ao(vec3 world_pos) {
  ivec3 dim = textureSize(OE_voxel_tex, 0);
  vec3 vs = oe_voxel_size(dim);
  float occ = 0.0;
  vec3  p = world_pos + vec3(0, vs.y, 0);
  for (int i = 0; i < 6; ++i) { 
    occ = max(occ, texture(OE_voxel_tex, oe_world_to_volume(p)).r); 
    p.y += vs.y; 
  }
  return mix(1.0, 1.0 - clamp(occ, 0.0, 1.0), OE_ao_strength);
}

void main() {
  // coord within the target face
  ivec3 texel_coord = ivec3(gl_GlobalInvocationID);
  ivec3 dim = imageSize(OE_env_cubemap);
  if (any(greaterThanEqual(texel_coord, dim))) {
    return;
  }
  
  vec3 uvw = (vec3(texel_coord) + 0.5) / vec3(dim);
  vec3 world_pos = world_min.xyz + uvw * world_extent();

  /// the sky's light and how much of it reaches the place. whether the sun does is the
  /// shadow map's to say, a place at a time: said here, half a unit at a time, it made
  /// every shadow a dark blur and took the sky's light away with the sun's
  vec3 irradiance = oe_sky_irradiance_up(world_pos);
  float ao = oe_sky_ao(world_pos);

  imageStore(OE_env_cubemap, texel_coord, vec4(irradiance, ao));
}