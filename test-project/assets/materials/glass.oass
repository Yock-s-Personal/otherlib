# transparent material: base_color.a < 1 routes the draw to the blended forward
# transparent-pass. known limits: casts no shadow and is invisible to the voxel/AO volume;
# pipelines without a transparent-pass skip it entirely. glass is not a metal: it is
# smooth, and what it mirrors grows as it is seen more from the side
material glass {
  base_color = [0.55, 0.78, 0.86, 0.5]
  roughness = 0.1
  metalness = 0.0
}
